{
	"cli": {
		"version": ">= 9.0.10",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"autoIncrement": true,
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"EXPO_PUBLIC_APP_VARIANT": "dev",
				"EXPO_PUBLIC_API_URL": "https://difeapp.com/api",
				"EXPO_PUBLIC_WS_URL": "wss://difeapp.com/ws",
				"EXPO_PUBLIC_MOCK_LOGIN": "true",
				"EXPO_PUBLIC_MOCK_EMAIL": "EXAMPLE_EMAIL",
				"EXPO_PUBLIC_MOCK_PASSWORD": "EXAMPLE_PASSWORD",
				"EXPO_PUBLIC_SHOW_CHAT_STATUS": "true"
			},
			"channel": "development"
		},
		"preview": {
			"distribution": "internal"
		},
		"production": {
			"autoIncrement": true,
			"ios": {
				"image": "macos-sequoia-15.6-xcode-26.1"
			},
			"env": {
				"EXPO_PUBLIC_API_URL": "https://difeapp.com/api",
				"EXPO_PUBLIC_WS_URL": "wss://difeapp.com/ws",
				"EXPO_PUBLIC_SHOW_REFRESH_TIMER": "true"
			},
			"channel": "production"
		},
		"staging": {
			"autoIncrement": true,
			"ios": {
				"image": "macos-sequoia-15.6-xcode-26.1"
			},
			"env": {
				"EXPO_PUBLIC_APP_VARIANT": "staging",
				"EXPO_PUBLIC_API_URL": "https://difeapp.com/api",
				"EXPO_PUBLIC_WS_URL": "wss://difeapp.com/ws",
				"EXPO_PUBLIC_SHOW_REFRESH_TIMER": "true"
			},
			"channel": "staging"
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleId": "EXAMPLE_APPLE_ID",
				"ascAppId": "6502968541",
				"appleTeamId": "YV6HCWQ47U"
			}
		},
		"staging": {
			"ios": {
				"appleId": "EXAMPLE_APPLE_ID",
				"ascAppId": "6670191789",
				"appleTeamId": "YV6HCWQ47U"
			}
		}
	}
}
