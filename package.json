{
	"name": "dife",
	"version": "1.0.0",
	"main": "node_modules/expo/AppEntry.js",
	"scripts": {
		"start": "expo start -c",
		"tunnel": "expo start --tunnel",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"lint": "npx eslint .",
		"lint:fix": "npm run lint -- --fix",
		"prettier": "npx prettier . --check",
		"prettier:debug": "npx prettier . --check --debug-check",
		"prettier:fix": "npm run prettier -- --write",
		"build-dev": "eas build --profile development --platform ios",
		"push-to-dev-with-branch": "npx dotenv -e .env.dev -- eas update --auto --branch",
		"push-to-dev": "npx dotenv -e .env.dev -- eas update --auto --branch $(git rev-parse --abbrev-ref HEAD)",
		"format": "npm run prettier:fix && npm run lint:fix"
	},
